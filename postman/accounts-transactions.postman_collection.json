{
  "info": {
    "name": "Accounts & Transactions Service",
    "description": "Coleccion de prueba del reto tecnico. Flujo: login -> crear cuenta -> transaccion -> idempotencia -> listar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "accountId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('token', json.accessToken);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
        }
      }
    },
    {
      "name": "2. Crear cuenta",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('accountId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"owner\": \"Anderson\",\n  \"currency\": \"PEN\",\n  \"initialBalance\": 100.00\n}"
        }
      }
    },
    {
      "name": "3. Obtener cuenta por id",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}"]
        }
      }
    },
    {
      "name": "4. Listar cuentas",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/accounts?offset=0&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["accounts"],
          "query": [
            { "key": "offset", "value": "0" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    },
    {
      "name": "5. Crear transaccion (DEBIT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status 201', () => pm.response.to.have.status(201));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Idempotency-Key", "value": "demo-key-001" }
        ],
        "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"type\": \"DEBIT\",\n  \"amount\": 30.00,\n  \"currency\": \"PEN\"\n}"
        }
      }
    },
    {
      "name": "6. Idempotencia (misma key, no duplica)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('devuelve la misma transaccion (no duplica)', () => {",
              "  pm.expect([200,201]).to.include(pm.response.code);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Idempotency-Key", "value": "demo-key-001" }
        ],
        "url": { "raw": "{{baseUrl}}/transactions", "host": ["{{baseUrl}}"], "path": ["transactions"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"type\": \"DEBIT\",\n  \"amount\": 30.00,\n  \"currency\": \"PEN\"\n}"
        }
      }
    },
    {
      "name": "7. Listar movimientos de la cuenta",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?offset=0&limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["accounts", "{{accountId}}", "transactions"],
          "query": [
            { "key": "offset", "value": "0" },
            { "key": "limit", "value": "20" }
          ]
        }
      }
    }
  ]
}